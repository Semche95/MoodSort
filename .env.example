# These values are embedded in plain text in the build: never put any credentials in these URLs
# Comma-separated ws:// or wss:// Nostr relays replacing Trystero's defaults
# Each relay must accept the ephemeral Nostr events Trystero publishes without authentication (no restricted writes, no pubkey whitelist)
# Leave empty to keep Trystero's defaults
VITE_SIGNALING_RELAYS=
# Comma-separated stun: or stuns: URLs replacing Trystero's default STUN servers
# Leave empty to keep Trystero's defaults
VITE_STUN_URLS=
