{
  "name": "emotion-cards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "atlas": "node scripts/generate-atlas.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dev": "node scripts/generate-atlas.mjs && node scripts/generate-icons.mjs && vite",
    "build": "node scripts/generate-atlas.mjs && node scripts/generate-icons.mjs && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jsdom": "^26.1.0",
    "lucide-static": "^1.34.0",
    "sharp": "^0.35.4",
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@pixi/ui": "^2.3.2",
    "pixi.js": "^8.20.1"
  }
}
