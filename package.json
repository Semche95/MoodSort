{
  "name": "moodsort",
  "description": "A visual emotion exploration tool. Arrange emotion cards on a canvas to identify and express what you're feeling.",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Semche95/MoodSort.git"
  },
  "scripts": {
    "atlas": "node scripts/generate-atlas.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dev": "node scripts/generate-atlas.mjs && node scripts/generate-icons.mjs && vite",
    "build": "node scripts/generate-atlas.mjs && node scripts/generate-icons.mjs && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lucide-static": "^1.48.0",
    "sharp": "^0.35.5",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@pixi/ui": "^2.3.2",
    "pixi.js": "^8.21.0",
    "trystero": "^0.25.4"
  }
}
